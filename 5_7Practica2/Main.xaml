  <Sequence DisplayName="Main Sequence" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="s:String[]" Name="ErrorCodes" Default="[{&quot;Ax001&quot;, &quot;Ax002&quot;, &quot;Ax003&quot;, &quot;Ax004&quot;, &quot;Ax005&quot;, &quot;Bx001&quot;, &quot;Bx002&quot;, &quot;Bx003&quot;, &quot;Cx001&quot;, &quot;Cx002&quot;, &quot;Cx003&quot;, &quot;Cx004&quot;}]" />
      <Variable x:TypeArguments="s:String[]" Name="AxArray" Default="[New String() {}]" />
      <Variable x:TypeArguments="s:String[]" Name="BxArray" Default="[New String() {}]" />
      <Variable x:TypeArguments="s:String[]" Name="CxArray" Default="[New String() {}]" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:ForEach x:TypeArguments="x:String" CurrentIndex="{x:Null}" DisplayName="Para cada código de error" sap2010:WorkflowViewState.IdRef="ForEach_1" Values="[ErrorCodes]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="x:String">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:String" Name="Value" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Procesar código" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <Switch x:TypeArguments="x:String" DisplayName="Cambiar tipo de código" Expression="[Value.Substring(0,2).ToLower]" sap2010:WorkflowViewState.IdRef="Switch_1">
              <Switch.Default>
                <ui:LogMessage DisplayName="Registrar código no reconocido" Level="Warn" Message="[&quot;No se encontró el código de error correspondiente para: &quot; + Value]" sap2010:WorkflowViewState.IdRef="LogMessage_Default" />
              </Switch.Default>
              <Sequence x:Key="ax" DisplayName="Caso ax" sap2010:WorkflowViewState.IdRef="Sequence_Ax">
                <Assign DisplayName="Añadir a AxArray" sap2010:WorkflowViewState.IdRef="Assign_Ax">
                  <Assign.To>
                    <OutArgument x:TypeArguments="s:String[]">[AxArray]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="s:String[]">[AxArray.Concat({Value}).ToArray]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
              <Sequence x:Key="bx" DisplayName="Caso bx" sap2010:WorkflowViewState.IdRef="Sequence_Bx">
                <Assign DisplayName="Añadir a BxArray" sap2010:WorkflowViewState.IdRef="Assign_Bx">
                  <Assign.To>
                    <OutArgument x:TypeArguments="s:String[]">[BxArray]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="s:String[]">[BxArray.Concat({Value}).ToArray]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
              <Sequence x:Key="cx" DisplayName="Caso cx" sap2010:WorkflowViewState.IdRef="Sequence_Cx">
                <Assign DisplayName="Añadir a CxArray" sap2010:WorkflowViewState.IdRef="Assign_Cx">
                  <Assign.To>
                    <OutArgument x:TypeArguments="s:String[]">[CxArray]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="s:String[]">[CxArray.Concat({Value}).ToArray]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </Switch>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <ui:LogMessage DisplayName="Registrar AxArray" Level="Info" Message="[String.Join(&quot; &quot;, AxArray)]" sap2010:WorkflowViewState.IdRef="LogMessage_Ax" />
    <ui:LogMessage DisplayName="Registrar BxArray" Level="Info" Message="[String.Join(&quot; &quot;, BxArray)]" sap2010:WorkflowViewState.IdRef="LogMessage_Bx" />
    <ui:LogMessage DisplayName="Registrar CxArray" Level="Info" Message="[String.Join(&quot; &quot;, CxArray)]" sap2010:WorkflowViewState.IdRef="LogMessage_Cx" />
  </Sequence>
</Activity>